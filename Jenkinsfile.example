pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                sh 'docker compose build'
            }
        }

        stage('Test') {
            steps {
                dir('backend') {
                    sh 'npm install'
                    sh 'npm test'
                }
            }
        }

        stage('Code Quality') {
            steps {
                sh 'echo "Running SonarQube analysis..."'
            }
        }

        stage('Security') {
            steps {
                sh 'npm audit || true'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker compose up -d'
            }
        }

        stage('Release') {
            steps {
                sh 'echo "Release version 1.0 deployed"'
            }
        }

        stage('Monitoring') {
            steps {
                sh 'curl http://localhost:5000/health'
            }
        }

    }
}
